# Expected environment variables — NEVER with values.
# The .env file is excluded in .gitignore; this file is its contract.
# Read order: HONEYLENS_ENV_FILE, ./.env, /opt/honeylens/.env, /opt/sensor/.env;
# a value from the file wins over os.environ (see honeylens/env.py). Generated from what
# honeylens.config actually reads — layer 1 of the port, 2026-09-19.

# ── Installation and sensor identification ────────────────────────────────
HONEYLENS_ENV_FILE=
HONEYLENS_STAMP_DIR=
INTERFACE=
SENSOR_HOME=
SENSOR_HOSTNAME=
SENSOR_INTERFACES=
SENSOR_SSH_PORT=

# ── Database ──────────────────────────────────────────────────────────────
DB_CONNECT_TIMEOUT=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_POOL_MAX=
DB_POOL_MIN=
DB_PORT=
DB_USER=

# ── API and TLS ───────────────────────────────────────────────────────────
API_AUTH_PASSWORD=
API_AUTH_USERNAME=
API_HOST=
API_PCAP_DIR=
API_PORT=
API_TLS_PORT=
TLS_CERT_DIR=
TLS_CERT_FILE=
TLS_EC_CURVE=
TLS_KEY_FILE=
TLS_KEY_TYPE=
TLS_MIN_VERSION=
TLS_RSA_BITS=

# ── eBPF and PCAP ─────────────────────────────────────────────────────────
DECEPTION_ENABLED=
DECEPTION_INTERFACE=
EBPF_CHECK_STRICT=
EBPF_CHECK_TIMEOUT=
EBPF_DISSECTION_RECONCILE_SEC=
EBPF_FULL_DISSECTION_ENABLED=
EBPF_LOG_FILE=
EBPF_PERF_BUFFER_PAGES=
EVENTS_JSON=
PCAP_DIR=

# ── Traffic filters ───────────────────────────────────────────────────────
# These drop events at INGEST — what they match is never stored. IGNORE_LOCAL_SOURCES in
# particular is a blunt instrument: widen it to a whole /24 and the sensor stops seeing the
# subnet it stands in. To keep capturing internal traffic but hide it from the dashboards,
# use DASHBOARD_EXCLUDE_SUBNETS below instead.
IGNORE_DST_PORT_ABOVE=
IGNORE_LOCAL_SOURCES=
IGNORE_SRC_HOST_PORTS=
IGNORE_SRC_PORT_ABOVE=
LLM_HONEYPOT_PORT=

# ── Dashboard / API views ─────────────────────────────────────────────────
# Comma-separated CIDRs hidden from the WebUI and API event views. A DISPLAY filter: the
# events stay captured, stored and classified, they just stop cluttering the dashboards with
# your own management, monitoring and backup traffic. Set this to YOUR internal ranges — the
# default is the range this project was developed against and will match nothing on your
# network. Several ranges are fine, and a bare address is treated as a /32.
#   DASHBOARD_EXCLUDE_SUBNETS=10.0.0.0/8,192.168.50.0/24
# A malformed entry is dropped silently, so read the value back after setting it.
DASHBOARD_EXCLUDE_SUBNETS=

# ── Honeypots and their logs ──────────────────────────────────────────────
FORTIGATE_BUILD=
FORTIGATE_ENABLED=
FORTIGATE_HOSTNAME=
FORTIGATE_LISTEN_HOST=
FORTIGATE_LOG_FILE=
FORTIGATE_MODEL=
FORTIGATE_PORTS=
FORTIGATE_SERIAL=
FORTIGATE_TLS_CERT=
FORTIGATE_TLS_KEY=
FORTIGATE_VERSION=
HONEYPOTNG_GLOB=
HONEYPOTNG_LOG_DIR=
HONEYWEB_HOST=
HONEYWEB_LOG_DIR=
HONEYWEB_PORT=
HONEYWEB_TLS_PORT=
# The PAN-OS decoy writes its events to these two files and honeylens-ingest-paloalto
# reads them back. SET BOTH on any sensor running the decoy in a container: the quadlet
# gives the CONTAINER a PALOALTO_LOG_FILE under its own /opt/logs mount, but the ingest
# runs on the HOST and sees none of that — unset, it falls back to /var/log/honeypot_paloalto*.json,
# finds nothing, reports "0 processed" and the decoy's events never reach the database.
# A sensor in that state runs a live PAN-OS decoy and records no PAN-OS events at all.
# Point them at the host side of the log mount, e.g.
#   PALOALTO_LOG_FILE=/home/<user>/honeylens-state/hp-logs/vendor/honeypot_paloalto.json
# PANOS_DATA_DIR (the identity volume) is deliberately NOT here: the decoy reads it
# straight from os.environ, not through this file, so it belongs in the quadlet.
PALOALTO_LISTEN_HOST=
PALOALTO_LOG_FILE=
PALOALTO_SSH_LOG_FILE=
WEBUI_NEW_SHELL=
HONEY_TLS_CIPHERS=
K8S_HONEYPOT_ENABLED=
K8S_HONEYPOT_LOG_FILE=

# ── Geolocation and testers ───────────────────────────────────────────────
GEOIP_DB_PATH=
TESTER_IPS_FILE=
TESTER_IPS_LIST=

# ── Event AI: Ollama locally, OpenAI/Nous/Anthropic externally ────────────
# Recommended split: cheap triage on a local/LAN Ollama, heavy deep analysis on a
# cloud backend. To run triage on Ollama and deep on Nous:
#   OLLAMA_URL=http://<ollama-host>:11434   # the triage (and LLM-honeypot) backend
#   OLLAMA_TRIAGE_MODEL=qwen2.5:3b          # a small model pulled on that Ollama
#   AI_DEEP_BACKEND=openai                  # delegate deep analysis to the cloud engine
#   AI_PROVIDER=nous                        # that engine talks to Nous (not api.openai.com)
#   NOUS_API_KEY=...                        # host .env only — never commit the key
# Leave AI_DEEP_BACKEND empty to keep deep local on OLLAMA_DEEP_MODEL.
AI_PROVIDER=openai
AI_ANALYSIS_ENABLED=
AI_ANALYZER_LOG_FILE=
AI_BATCH_SIZE=
AI_CYCLE_INTERVAL=
AI_TRIAGE_MIN_SEVERITY=
ANTHROPIC_API_KEY=
ANTHROPIC_DEEP_MODEL=
ANTHROPIC_TRIAGE_MODEL=
AUTO_EXTERNAL_AI=
# Hybrid deep: unset = deep stays on the local Ollama; "openai" = deep via the cloud
# engine selected by AI_PROVIDER (openai or nous); "claude" = deep via Anthropic.
AI_DEEP_BACKEND=
# true = the analyzer skips the local Ollama and runs triage AND deep on the cloud
# backend (AI_PROVIDER). For hosts where local inference is too slow/memory-starved;
# the local Ollama stays up for other consumers (the LLM honeypot).
AI_FORCE_CLOUD=
DEEP_ANALYSIS_ENGINE=
OLLAMA_DEEP_MODEL=
OLLAMA_TIMEOUT=
OLLAMA_TRIAGE_MODEL=
# The Ollama backend for event triage and the LLM honeypot, e.g. http://192.0.2.50:11434.
OLLAMA_URL=
USE_EXTERNAL_AI=
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
NOUS_TRIAGE_MODEL=qwen/qwen3-30b-a3b-instruct-2507
NOUS_DEEP_MODEL=qwen/qwen3-30b-a3b-instruct-2507

