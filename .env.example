OPENAI_TRIAGE_BASE_URL=
OPENAI_TRIAGE_API_KEY=
OPENAI_TRIAGE_MODEL=

# LDAP/AD authentication (auth/ldap_auth.py) — optional
# Three things that are easy to get wrong:
#  * Only a login containing '@' is sent to AD; a plain username always takes the local
#    path. Keep ONE local account as break-glass, or an AD outage locks you out entirely.
#  * Point LDAP_SERVER at the DC's FQDN, not its IP. ldap3 validates the certificate against
#    the DNS names only and ignores an iPAddress SAN, so an IP fails hostname validation even
#    when the certificate lists it. Resolve the name, or add it to /etc/hosts.
#  * Do NOT reach for LDAP_ALLOW_INSECURE_TLS to work around that — it stops validating the
#    LDAPS certificate, so the submitted password goes to anything impersonating the DC.
LDAP_ENABLED=
LDAP_SERVER=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=
LDAP_GROUP_ADMIN=
LDAP_GROUP_VIEWER=
LDAP_CA_CERT=
LDAP_ALLOW_INSECURE_TLS=
LDAP_DEFAULT_ROLE=
DB_ARCHIVE_DIR=
DB_ARCHIVE_DAYS=
DB_ARCHIVE_EXPORT=
DB_ARCHIVE_CLEANUP=
BACKUP_PASSWORD=
