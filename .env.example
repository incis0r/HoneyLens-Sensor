PROFILER_OLLAMA_MODEL=
# Opt in to Nous instead of local Ollama. Store the key only in the host .env.
PROFILER_AI_PROVIDER=ollama
NOUS_API_KEY=
PROFILER_NOUS_MODEL=qwen/qwen3-30b-a3b-instruct-2507
PROFILER_AI_MAX_TOKENS=1024

