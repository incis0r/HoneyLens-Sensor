[Unit]
# HoneyLens MITM detector — ONE instance per monitored interface; the systemd template
# instance (%i) IS the interface, e.g. `honeylens-mitm@eno1.420`. Enable one per live VLAN
# (and one for the trunk, e.g. `honeylens-mitm@eno1`).
#
# This is a SYSTEM unit, NOT a `systemctl --user` unit like the honeypot quadlets: sniffing an
# interface needs CAP_NET_RAW, which a rootless user service cannot obtain. Install into
# /etc/systemd/system/ (or ~/.config via a drop-in only if the user has the caps — normally not).
#
# Replaces the 0.9 per-VLAN `sensor-mitm-eno1-NNN.service`.
#
# The paths point at the `sensor` service account, which is where the sensor tree belongs — not
# at an operator's login account. They are spelled out because a system unit's %h is root's
# home, so %h cannot stand in here. If your service account is named differently, change the
# three paths below; what must not happen is pointing them back at a human login account, whose
# home gets `ProtectHome`d, relocated or removed and takes the sensor down with it.
Description=HoneyLens MITM detector (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/sensor/sensor-1.0
EnvironmentFile=-/home/sensor/honeylens-state/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/sensor/sensor-1.0/.venv/bin/honeylens-mitm-detector -i %i
Restart=on-failure
RestartSec=15
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
