# Queued hunts run even when automatic discovery is disabled.
PROFILER_AUTO=true
PROFILER_BATCH_SIZE=10
PROFILER_INTERVAL=300
PROFILER_MIN_ATTACKS=1
PROFILER_MIN_CONNECTIONS=3
PROFILER_REPROFILE_INTERVAL=21600
